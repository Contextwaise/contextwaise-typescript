# Copy to sdk/typescript/.env. Every key is optional: without them the demo is free and local.

# Real agent model (paid, a few cents per question). Without it: a free simulated model.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# Your Contextwaise app: relevance by Jev, and results on its "Tool results" page.
CONTEXTWAISE_API_KEY=
CONTEXTWAISE_URL=http://localhost:3000
