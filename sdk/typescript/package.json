{
  "name": "contextwaise",
  "version": "0.1.0",
  "description": "Shrink agent tool results at birth: cache-safe, reversible, intent-aware.",
  "homepage": "https://contextwaise.com/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Contextwaise/contextwaise-typescript.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/Contextwaise/contextwaise-typescript/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    }
  },
  "scripts": {
    "build": "npm --prefix ../../core run build && rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --conditions=contextwaise-source --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "ai": ">=6"
  },
  "dependencies": {
    "@contextwaise/core": "^0.1.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "^7.0.127"
  }
}
